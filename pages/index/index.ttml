<navigator
  url="/pages/web/index?path=/org/me"
  open-type="navigate"
  class="media as-me px-4 py-3"
>
  <view class="media-left">
    <view class="is-avatar">
      <text class="text">奶</text>
    </view>
  </view>
  <view class="media-right text-white">

  </view>
</navigator>

<view class="card as-transparent">
  <view class="card-header">
    <text class="size-7 text-grey has-border-left-primary">常用功能</text>
  </view>
  <view class="card-content fixed-grid has-3-cols">
    <view class="grid">
      <navigator
        tt:for="{{res}}"
        url="/pages/web/index?path={{item.path}}"
        open-type="navigate"
        class="cell has-column-centered"
        hover-class="navigator-hover"
        hover-start-time="50" 
        hover-stay-time="400" 
        hover-stop-propagation="{{false}}"
      >
        <image class="icon is-medium text-primary" src="/assets/light/{{item.icon}}.svg"></image>
        <view class="size-7 text-grey is-wrap text-centered mt-1">{{item.name}}</view>
      </navigator>
    </view>
  </view>
</view>
