<navigator
  url="/pages/web/index"
  open-type="redirect" 
  hover-class="navigator-hover"
  hover-start-time="50" 
  hover-stay-time="400" 
  hover-stop-propagation="{{false}}"
>
  <view class="icon-wrapper">
    <image class="icon-image" src="/logo.png"></image>
  </view>
  <view class="text-primary">ERP</view>
</navigator>
